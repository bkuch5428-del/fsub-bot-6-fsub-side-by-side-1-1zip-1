# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MongoDB connection string (Atlas free tier works fine)
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/fsubbot

# Comma-separated Telegram numeric user IDs who can use admin commands
# Get your own ID by messaging @userinfobot
ADMIN_IDS=111111111,222222222

# Your bot's username WITHOUT the @ (used to build deep links)
BOT_USERNAME=your_bot_username

# Optional: a private channel ID used as internal file storage backup
# Leave empty if you don't want this
LOG_CHANNEL_ID=
